<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.wicketstuff</groupId>
		<artifactId>datatables-parent</artifactId>
		<version>12.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>wicketstuff-datatables</artifactId>
	<packaging>jar</packaging>

	<name>DataTables jQuery Plugin Integration</name>
	<description>DataTables jQuery integration for Wicket</description>

	<properties>
		<datatables.version>3.1.5</datatables.version>
		<datatables-select.version>4.1.1</datatables-select.version>
		<datatables-scroller.version>3.1.1</datatables-scroller.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-extensions</artifactId>
		</dependency>
		<dependency>
			<groupId>de.agilecoders.wicket.webjars</groupId>
			<artifactId>wicket-webjars</artifactId>
		</dependency>
		<!-- DataTables 3 has no dependencies; the Select and Scroller releases for DataTables 3
		     require DataTables 3.1, which is only published as npm webjars -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net</artifactId>
			<version>${datatables.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-dt</artifactId>
			<version>${datatables.version}</version>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-bs5</artifactId>
			<version>${datatables.version}</version>
			<exclusions>
				<!-- only the stylesheet and the styling integration are needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-select</artifactId>
			<version>${datatables-select.version}</version>
			<exclusions>
				<!-- datatables.net is declared above -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-select-dt</artifactId>
			<version>${datatables-select.version}</version>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-select-bs5</artifactId>
			<version>${datatables-select.version}</version>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-scroller</artifactId>
			<version>${datatables-scroller.version}</version>
			<exclusions>
				<!-- datatables.net is declared above -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-scroller-dt</artifactId>
			<version>${datatables-scroller.version}</version>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-scroller-bs5</artifactId>
			<version>${datatables-scroller.version}</version>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- the stylesheets of the other styles are added by the application; they are only
		     needed to check that the rendered stylesheet references resolve -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-zf</artifactId>
			<version>${datatables.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-select-zf</artifactId>
			<version>${datatables-select.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-scroller-zf</artifactId>
			<version>${datatables-scroller.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-jqui</artifactId>
			<version>${datatables.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-select-jqui</artifactId>
			<version>${datatables-select.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-scroller-jqui</artifactId>
			<version>${datatables-scroller.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-bs</artifactId>
			<version>${datatables.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-select-bs</artifactId>
			<version>${datatables-select.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>datatables.net-scroller-bs</artifactId>
			<version>${datatables-scroller.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- only the stylesheet is needed -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>bootstrap</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>de.agilecoders.wicket</groupId>
			<artifactId>jquery-selectors</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-tester</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
