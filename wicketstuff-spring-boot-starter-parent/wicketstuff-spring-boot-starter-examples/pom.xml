<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.wicketstuff</groupId>
		<artifactId>wicketstuff-spring-boot-starter-parent</artifactId>
		<version>10.12.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>wicketstuff-spring-boot-starter-examples</artifactId>
	<packaging>jar</packaging>

	<name>WicketStuff Spring Boot Starter - Examples</name>
	<description>
		Example application demonstrating the use of Wicket Spring Boot Starter.
	</description>

	<dependencies>
		<!-- The Starter. It brings the web stack with it, so this example deliberately
		     declares nothing else at compile scope. -->
		<dependency>
			<groupId>org.wicketstuff</groupId>
			<artifactId>wicketstuff-spring-boot-starter</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Spring Boot Starter Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- TestRestTemplate: since Spring Boot 4, this is no longer pulled in transitively
		     by spring-boot-starter-test and must be declared explicitly. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- spring-boot-resttestclient's TestRestTemplateTestAutoConfiguration references
		     RestTemplateBuilder but doesn't declare spring-boot-restclient as a dependency
		     itself, so it must be added explicitly too. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Keeps StarterSelfSufficiencyTest meaningful: this module must get its web stack
			     from wicketstuff-spring-boot-starter alone, never from a Spring Boot starter declared
			     here. Only direct declarations are checked, so what the starter pulls in
			     transitively is unaffected. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-starter-is-the-only-compile-dependency</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<searchTransitive>false</searchTransitive>
									<excludes>
										<exclude>org.springframework.boot:spring-boot-starter-*</exclude>
									</excludes>
									<includes>
										<include>org.springframework.boot:spring-boot-starter-*:*:*:test</include>
									</includes>
									<message>
										This example must depend on nothing but wicketstuff-spring-boot-starter at
										compile scope, so that StarterSelfSufficiencyTest proves the starter
										brings a working web application on its own. Declaring a Spring Boot
										starter here would satisfy that test without the starter supplying
										anything. Add the dependency to the starter instead.
									</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>${spring-boot.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
