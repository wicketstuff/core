<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.wicketstuff</groupId>
		<artifactId>wicketstuff-core</artifactId>
		<version>10.12.0-SNAPSHOT</version>
	</parent>

	<artifactId>wicketstuff-spring-boot-starter-parent</artifactId>
	<packaging>pom</packaging>

	<name>WicketStuff Spring Boot Starter - Parent</name>
	<description>
		Parent project for Wicket Spring Boot Starter module and its example application.
	</description>

	<properties>
		<spring-boot.version>4.1.1</spring-boot.version>

		<!-- wicketstuff-core pins these libraries for its own modules, and Maven lets those inherited
		     pins win over the spring-boot-dependencies BOM imported below. Left alone, the starter
		     would be built and tested against versions no Spring Boot application ever runs with
		     (and, worse, against a mix of them, e.g. jackson-databind from one minor line with
		     jackson-core from another). Overriding the properties here puts every module under this
		     parent back on exactly what Spring Boot ${spring-boot.version} ships.

		     Keep these equal to the spring-boot-dependencies property named after each one.
		     BuildAlignedWithSpringBootTest fails the build as soon as they drift apart, e.g. after
		     Spring Boot is bumped or a dependency update PR touches one of them. -->
		<spring.version>7.0.9</spring.version>                 <!-- spring-framework.version -->
		<jackson.version>3.1.5</jackson.version>               <!-- jackson-bom.version -->
		<jackson2.version>2.21.5</jackson2.version>            <!-- jackson-2-bom.version -->
		<slf4j.version>2.0.18</slf4j.version>                  <!-- slf4j.version -->
		<logback.version>1.5.38</logback.version>              <!-- logback.version -->
		<log4j.version>2.25.5</log4j.version>                  <!-- log4j2.version -->
		<commons-logging.version>1.3.6</commons-logging.version> <!-- commons-logging.version -->
		<junit.version>6.0.3</junit.version>                   <!-- junit-jupiter.version -->
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Manage all org.springframework.boot artifact versions from the official BOM,
			     rather than hardcoding ${spring-boot.version} on each individual dependency. -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<modules>
		<module>wicketstuff-spring-boot-starter</module>
		<module>wicketstuff-spring-boot-starter-examples</module>
	</modules>
</project>
